# Database Configuration
# Get your connection string from Supabase: Settings → Database → Connection String
# Choose "Connection pooler" mode for better performance
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]

# Clerk Authentication (if using Clerk for authentication)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# WhatsApp Session Configuration
WHATSAPP_AUTH_DIR=data/whatsapp-auth

# Server Port
PORT=5000

# Base Path (for reverse proxy deployments)
BASE_PATH=/

# Environment
NODE_ENV=development
LOG_LEVEL=info
